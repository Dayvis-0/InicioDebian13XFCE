# Screen dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Detectar el modo de Plymouth (boot, shutdown, reboot)
mode = Plymouth.GetMode();

# Solo mostrar el fondo y el texto si estamos INICIANDO el sistema ("boot")
if (mode == "boot") {

    # 1. Background Wallpaper (Z = -1000)
    bg_image = Image("background.png");
    if (bg_image) {
        window_max_width = Window.GetX() * 2 + Window.GetWidth();
        window_max_height = Window.GetY() * 2 + Window.GetHeight();
        screen_ratio = window_max_width / window_max_height;
        bg_image_ratio = bg_image.GetWidth() / bg_image.GetHeight();
        
        if (screen_ratio > bg_image_ratio)
            bg_scale_factor = window_max_width / bg_image.GetWidth();
        else
            bg_scale_factor = window_max_height / bg_image.GetHeight();
            
        scaled_bg_image = bg_image.Scale(bg_image.GetWidth() * bg_scale_factor,
                                         bg_image.GetHeight() * bg_scale_factor);
                                         
        bg_sprite = Sprite(scaled_bg_image);
        bg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - scaled_bg_image.GetWidth() / 2,
                              Window.GetY() + Window.GetHeight() / 2 - scaled_bg_image.GetHeight() / 2,
                              -1000);
    }

    # 2. Status Text ("Iniciando Debian...")
    title_image = Image.Text("Iniciando Debian...", 1.0, 1.0, 1.0, 1.0, "Roboto Bold 38");
    if (!title_image) {
        title_image = Image.Text("Iniciando Debian...", 1.0, 1.0, 1.0, 1.0, "Noto Sans Bold 38");
    }
    if (!title_image) {
        title_image = Image.Text("Iniciando Debian...", 1.0, 1.0, 1.0, 1.0, "DejaVu Sans Bold 38");
    }
    if (!title_image) {
        title_image = Image.Text("Iniciando Debian...", 1.0, 1.0, 1.0, 1.0, "Sans-Serif Bold 38");
    }

    if (title_image) {
        title_sprite = Sprite(title_image);
        title_y = Window.GetY() + Window.GetHeight() * 0.76;
        title_sprite.SetPosition(Window.GetX() + (Window.GetWidth() - title_image.GetWidth()) / 2, title_y, 100);
    }

}

# Quit handler
fun quit_callback() {
}
Plymouth.SetQuitFunction(quit_callback);
